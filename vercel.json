{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{local/**,docs/**,stitch_cinetube_movie_hub/**,**/*.log}",
      "maxDuration": 30
    }
  }
}

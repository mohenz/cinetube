{
  "manifest_version": 3,
  "name": "CineTube 123AV & MissAV Exporter",
  "version": "1.5",
  "description": "123AV / MissAV 상세 페이지에서 메타데이터를 추출하여 CineTube 서버에 바로 등록합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

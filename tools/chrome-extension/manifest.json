{
  "manifest_version": 3,
  "name": "CineTube 123AV & MissAV Exporter",
  "version": "1.3",
  "description": "123AV / MissAV 상세 페이지에서 메타데이터를 추출하여 CineTube 로컬 서버에 바로 등록합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
